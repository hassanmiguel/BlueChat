// Prisma Schema for blueChat
// PostgreSQL database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USER ============
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  discriminator String    @default("0001")
  email         String    @unique
  password      String?
  emailVerified Boolean   @default(false)
  avatar        String?
  banner        String?
  bio           String?   @db.Text
  pronouns      String?
  status        UserStatus @default(ONLINE)
  customStatus  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeen      DateTime  @default(now())
  notificationPrefs Json?

  // Relations
  servers       ServerMember[]
  ownedServers  Server[]       @relation("ServerOwner")
  messages      Message[]
  reactions     Reaction[]
  sentRequests  FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  blocks        Block[]         @relation("Blocker")
  blockedBy     Block[]         @relation("Blocked")
  directMessages DirectMessageParticipant[]
  dmMessages    DirectMessageMessage[]
  dmReactions   DmReaction[]
  ownedDms      DirectMessage[] @relation("DmOwner")
  sessions      Session[]
  auditLogs     AuditLog[]
  bans          Ban[]
  timeouts      Timeout[]
  verificationTokens VerificationToken[]
  oauthAccounts OAuthAccount[]
  notifications Notification[]
  reports       Report[]

  @@map("users")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String                 @id @default(cuid())
  userId    String
  tokenHash String                 @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime               @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
  OFFLINE
}

// ============ SESSION ============
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============ SERVER ============
model Server {
  id               String   @id @default(cuid())
  name             String
  icon             String?
  banner           String?
  description      String?  @db.Text
  inviteCode       String   @unique @default(cuid())
  region           String   @default("us-east")
  verificationLevel VerificationLevel @default(NONE)
  autoModEnabled   Boolean   @default(false)
  blockedWords     String[]  @default([])
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  owner            User     @relation("ServerOwner", fields: [ownerId], references: [id])
  members          ServerMember[]
  channels         Channel[]
  roles            Role[]
  categories       Category[]
  invites          ServerInvite[]
  auditLogs        AuditLog[]
  bans             Ban[]
  reports          Report[]

  @@map("servers")
}

enum VerificationLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

// ============ SERVER MEMBER ============
model ServerMember {
  id        String   @id @default(cuid())
  userId    String
  serverId  String
  nickname  String?
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  roles     RoleMember[]

  @@unique([userId, serverId])
  @@map("server_members")
}

// ============ ROLE ============
model Role {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#949ba4")
  icon        String?
  permissions String[] @default([])
  position    Int      @default(0)
  serverId    String
  createdAt   DateTime @default(now())

  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members     RoleMember[]
  channelOverrides ChannelPermissionOverride[]

  @@map("roles")
}

model RoleMember {
  id     String @id @default(cuid())
  roleId String
  memberId String

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  member ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([roleId, memberId])
  @@map("role_members")
}

// ============ CATEGORY ============
model Category {
  id        String   @id @default(cuid())
  name      String
  position  Int      @default(0)
  serverId  String
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels  Channel[]

  @@map("categories")
}

// ============ CHANNEL ============
model Channel {
  id          String      @id @default(cuid())
  name        String
  type        ChannelType @default(TEXT)
  topic       String?     @db.Text
  position    Int         @default(0)
  isNsfw      Boolean     @default(false)
  slowMode    Int?        // seconds between messages
  serverId    String
  categoryId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages    Message[]
  permissionOverrides ChannelPermissionOverride[]
  threads     Thread[]

  @@map("channels")
}

enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  FORUM
  STAGE
}

model ChannelPermissionOverride {
  id         String   @id @default(cuid())
  channelId  String
  roleId     String
  allow      String[] @default([])
  deny       String[] @default([])

  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId])
  @@map("channel_permission_overrides")
}

// ============ MESSAGE ============
model Message {
  id          String   @id @default(cuid())
  content     String   @db.Text
  channelId   String
  authorId    String
  replyToId   String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     Message? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[] @relation("MessageReplies")
  attachments Attachment[]
  reactions   Reaction[]
  mentions    Mention[]
  edits       MessageEdit[]

  @@index([channelId, createdAt])
  @@map("messages")
}

model MessageEdit {
  id        String   @id @default(cuid())
  messageId String
  content   String   @db.Text
  editedAt  DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_edits")
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  filename  String
  url       String
  type      String   // image, video, audio, file
  mimeType  String?
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("reactions")
}

model Mention {
  id        String      @id @default(cuid())
  messageId String
  type      MentionType
  targetId  String      // userId or roleId

  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("mentions")
}

enum MentionType {
  USER
  ROLE
  CHANNEL
  EVERYONE
}

// ============ THREAD ============
model Thread {
  id          String   @id @default(cuid())
  name        String
  channelId   String
  ownerId     String
  isLocked    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("threads")
}

// ============ DIRECT MESSAGE ============
model DirectMessage {
  id          String   @id @default(cuid())
  isGroup     Boolean  @default(false)
  name        String?
  description String?  @db.Text
  avatar      String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User?                     @relation("DmOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  participants DirectMessageParticipant[]
  messages     DirectMessageMessage[]

  @@map("direct_messages")
}

model DirectMessageParticipant {
  id         String    @id @default(cuid())
  dmId       String
  userId     String
  lastReadAt DateTime?
  muted      Boolean   @default(false)

  dm     DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dmId, userId])
  @@map("dm_participants")
}

model DirectMessageMessage {
  id        String    @id @default(cuid())
  content   String    @db.Text
  dmId      String
  authorId  String
  replyToId String?
  isPinned  Boolean   @default(false)
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dm         DirectMessage           @relation(fields: [dmId], references: [id], onDelete: Cascade)
  author     User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo    DirectMessageMessage?   @relation("DmMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    DirectMessageMessage[]  @relation("DmMessageReplies")
  reactions  DmReaction[]
  attachments DmAttachment[]

  @@index([dmId, createdAt])
  @@map("dm_messages")
}

model DmReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message DirectMessageMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("dm_reactions")
}

model DmAttachment {
  id        String @id @default(cuid())
  messageId String
  url       String
  filename  String
  mimeType  String
  size      Int

  message DirectMessageMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("dm_attachments")
}

// ============ FRIEND SYSTEM ============
model FriendRequest {
  id          String         @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendStatus   @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sender      User           @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User           @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

// ============ SERVER INVITE ============
model ServerInvite {
  id          String   @id @default(cuid())
  code        String   @unique @default(cuid())
  serverId    String
  creatorId   String
  maxUses     Int?
  uses        Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_invites")
}

// ============ MODERATION ============
model Ban {
  id        String   @id @default(cuid())
  serverId  String
  userId    String
  reason    String?  @db.Text
  expiresAt DateTime?
  bannedById String
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@map("bans")
}

model Timeout {
  id        String   @id @default(cuid())
  serverId  String
  userId    String
  reason    String?
  expiresAt DateTime
  createdById String
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@map("timeouts")
}

model AuditLog {
  id        String      @id @default(cuid())
  serverId  String
  userId    String
  action    AuditAction
  target    String?
  metadata  Json?
  createdAt DateTime    @default(now())

  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@index([serverId, createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  SERVER_UPDATE
  CHANNEL_CREATE
  CHANNEL_UPDATE
  CHANNEL_DELETE
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  MEMBER_KICK
  MEMBER_BAN
  MEMBER_UNBAN
  MEMBER_TIMEOUT
  MESSAGE_DELETE
  MESSAGE_PIN
  INVITE_CREATE
  INVITE_DELETE
  REPORT_CREATED
  REPORT_RESOLVED
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?   @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  serverId    String?
  targetType  String
  targetId    String
  reason      String   @db.Text
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  server      Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@map("reports")
}
