# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bluechat?schema=public"

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
PUBLIC_URL="http://localhost:3001"

# JWT (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"

# Cookies
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Email (set a webhook that receives {to, subject, template, token, link})
EMAIL_WEBHOOK_URL=""
EMAIL_FROM="no-reply@bluechat.local"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/oauth/google/callback"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3001/api/auth/oauth/github/callback"

# File Upload (optional)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=26214400

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
